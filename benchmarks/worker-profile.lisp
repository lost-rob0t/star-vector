;; Benchmark-only instrumentation, loaded after either pinned or candidate
;; adapter. Normal distributed worker images do not load this file.
(defpackage :sv-memory-profile (:use :cl) (:export :run))
(in-package :sv-memory-profile)

(defvar *directory* nil)
(defvar *scanning* nil)
(defvar *rows* 0)
(defvar *callback-bytes* 0)
(defvar *max-callback-bytes* 0)
(defvar *heap-peak* 0)
(defvar *gcs* 0)

(defun sample-heap ()
  (setf *heap-peak* (max *heap-peak* (sb-kernel:dynamic-usage))))

(defun snapshot (phase)
  (sample-heap)
  (let ((record (jsown:new-js
                 ("phase" phase) ("pid" (sb-posix:getpid))
                 ("allocated_bytes" (sb-ext:get-bytes-consed))
                 ("dynamic_used_bytes" (sb-kernel:dynamic-usage))
                 ("sampled_dynamic_peak_bytes" *heap-peak*)
                 ("callback_allocated_bytes" *callback-bytes*)
                 ("max_callback_allocated_bytes" *max-callback-bytes*)
                 ("rows" *rows*) ("gc_count" *gcs*)
                 ("gc_cpu_seconds" (/ sb-ext:*gc-run-time*
                                      (float internal-time-units-per-second 1d0))))))
    (with-open-file (out (merge-pathnames (format nil "~D.jsonl" (sb-posix:getpid)) *directory*)
                         :direction :output :if-exists :append :if-does-not-exist :create)
      (write-line (jsown:to-json record) out))))

(defun maybe-collect ()
  (let ((marker (merge-pathnames (format nil "~D.collect" (sb-posix:getpid)) *directory*)))
    (when (probe-file marker)
      (delete-file marker)
      (snapshot "before_full_gc")
      (sb-ext:gc :full t)
      (snapshot "after_full_gc"))))

(defun install-instrumentation ()
  (push (lambda () (incf *gcs*)) sb-ext:*after-gc-hooks*)
  (let ((original (symbol-function 'tek9:map-database)))
    (setf (symbol-function 'tek9:map-database)
          (lambda (db &rest options)
            (if (not *scanning*)
                (apply original db options)
                (let* ((options (copy-list options))
                       (callback (getf options :map-fn #'list)))
                  (setf (getf options :map-fn)
                        (lambda (id document)
                          (when (zerop (mod *rows* 128)) (sample-heap))
                          (let ((before (sb-ext:get-bytes-consed)))
                            (funcall callback id document)
                            (let ((allocated (- (sb-ext:get-bytes-consed) before)))
                              (incf *callback-bytes* allocated)
                              (setf *max-callback-bytes* (max *max-callback-bytes* allocated))))
                          (incf *rows*)
                          (when (zerop (mod *rows* 128)) (sample-heap))))
                  (apply original db options))))))
  (let ((original (symbol-function 'star-vector-tek9::open-store)))
    (setf (symbol-function 'star-vector-tek9::open-store)
          (lambda (request)
            (multiple-value-prog1 (funcall original request) (snapshot "open")))))
  (let ((original (symbol-function 'star-vector-tek9::dispatch)))
    (setf (symbol-function 'star-vector-tek9::dispatch)
          (lambda (db request)
            (maybe-collect)
            (if (equal (jsown:val request "op") "scan")
                (let ((*scanning* t) (*rows* 0) (*callback-bytes* 0)
                      (*max-callback-bytes* 0) (*heap-peak* 0))
                  (snapshot "scan_start")
                  (unwind-protect (funcall original db request) (snapshot "scan_end")))
                (funcall original db request))))))

(defun run ()
  (let ((directory (uiop:getenv "SV_PROFILE_DIR")))
    (when directory
      (setf *directory* (uiop:ensure-directory-pathname directory))
      (install-instrumentation)
      (snapshot "boot")))
  (star-vector-tek9:run))
